<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HuorongAce.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="火绒ACE">

    <Grid
        x:Name="RootLayout"
        UseLayoutRounding="True"
        IsTabStop="True"
        PointerPressed="OnRootPointerPressed"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar keeps the system caption buttons while matching the app theme. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="32"
            Padding="16,0,0,0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            AutomationProperties.Name="火绒ACE 标题栏">
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Microsoft YaHei UI"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                IsHitTestVisible="False"
                Text="火绒ACE" />
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            FontFamily="Microsoft YaHei UI"
            PaneTitle="设置"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="248"
            CompactModeThresholdWidth="720"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    PlaceholderText="搜索设置"
                    QueryIcon="Find"
                    TextChanged="OnSearchTextChanged" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavMonitor" Content="监控" Tag="Monitor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavActions" Content="测试与保存" Tag="Actions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavHelp" Content="使用说明" Tag="Help">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,36" Spacing="18" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="管理监控行为、日志来源和测试操作" Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>

                    <InfoBar
                        x:Name="StatusBar"
                        IsOpen="True"
                        IsClosable="False"
                        IsIconVisible="True"
                        Severity="Warning"
                        Title="监控状态"
                        Message="正在读取…" />

                    <StackPanel x:Name="MonitorPage" Spacing="12">
                        <TextBlock Text="监控" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                        <TextBlock Text="启用监控" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="监控火绒日志，命中威胁时弹出红屏提示" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="1" HorizontalAlignment="Right" OnContent="开" OffContent="关" Toggled="OnEnabledToggled" />
                                </Grid>

                                <Rectangle Grid.Row="1" Style="{StaticResource DividerStyle}" />

                                <Grid Grid.Row="2" Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                        <TextBlock Text="开机自启" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="登录 Windows 后自动启动并隐藏到托盘运行" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" HorizontalAlignment="Right" OnContent="开" OffContent="关" Toggled="OnStartupToggled" />
                                </Grid>

                                <Rectangle Grid.Row="3" Style="{StaticResource DividerStyle}" />

                                <Grid Grid.Row="4" Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                        <TextBlock Text="轮询间隔" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="每隔多少秒检查一次火绒日志，最小值为 1 秒" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="PollIntervalBox" Grid.Column="1" Width="116" MaxLength="4" PlaceholderText="秒" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Grid.Row="5" Style="{StaticResource DividerStyle}" />

                                <Grid Grid.Row="6" Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1*" MinWidth="180" MaxWidth="360" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                        <TextBlock Text="病毒关键词" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="自定义日志库使用，多个关键词请用英文逗号分隔" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="KeywordsBox" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="例如：Trojan, Malware" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="火绒日志" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                    <TextBlock Text="日志数据库路径" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="LogPathText" Style="{StaticResource RowDescriptionStyle}" FontFamily="Consolas" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="BrowseButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnBrowseClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8E5;" />
                                        <TextBlock Text="选择文件" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ActionsPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="操作" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                        <TextBlock Text="测试红屏" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="立即模拟一次检测，验证红屏效果" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnTestClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" />
                                            <TextBlock Text="开始测试" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Rectangle Style="{StaticResource DividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                                        <TextBlock Text="保存设置" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="将当前设置写入配置文件并立即应用" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="OnSaveClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74E;" />
                                            <TextBlock Text="保存设置" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HelpPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="使用说明" Style="{StaticResource SectionHeaderStyle}" />

                        <TextBlock Text="程序流程" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource FlowNodeStyle}">
                                    <TextBlock Text="启动程序" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="↓" Style="{StaticResource FlowArrowStyle}" />
                                <Border Style="{StaticResource FlowNodeStyle}">
                                    <TextBlock Text="注册托盘与通知身份" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="↓" Style="{StaticResource FlowArrowStyle}" />
                                <Border Style="{StaticResource FlowNodeStyle}">
                                    <TextBlock Text="读取配置并打开日志数据库" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="↓" Style="{StaticResource FlowArrowStyle}" />
                                <Border Style="{StaticResource FlowNodeStyle}">
                                    <TextBlock Text="启动监控，按轮询间隔检查日志" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="↓" Style="{StaticResource FlowArrowStyle}" />
                                <Border Style="{StaticResource FlowNodeStyle}">
                                    <TextBlock Text="检测到威胁？" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                                </Border>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FlowNodeStyle}" MinWidth="0">
                                        <TextBlock Text="否：等待下一轮轮询" Style="{StaticResource RowDescriptionStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource FlowNodeStyle}" MinWidth="0">
                                        <TextBlock Text="是：弹出红屏并发送通知" Style="{StaticResource RowDescriptionStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="↓" Style="{StaticResource FlowArrowStyle}" />
                                <Border Style="{StaticResource FlowNodeStyle}">
                                    <TextBlock Text="托盘打开设置、保存配置或退出程序" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="火绒ACE" Style="{StaticResource PageTitleStyle}" FontSize="22" />
                                <TextBlock
                                    Text="本项目基于 MIT License 开源，欢迎查看源码、提交问题和改进建议。"
                                    Style="{StaticResource BodyTextStyle}"
                                    TextWrapping="Wrap" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="项目仓库" Style="{StaticResource RowTitleStyle}" />
                                    <HyperlinkButton
                                        Content="github.com/FIOIU8/Huorong-ACE"
                                        NavigateUri="https://github.com/FIOIU8/Huorong-ACE"
                                        HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock
                                    Text="许可证：MIT License"
                                    Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
