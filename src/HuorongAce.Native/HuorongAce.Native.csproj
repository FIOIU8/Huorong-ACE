<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only by design: everything here is Win32 / GDI+. Declaring the
         platform also silences the CA1416 platform-compatibility analysis. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HuorongAce.Native</RootNamespace>
    <AssemblyName>HuorongAce.Native</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HuorongAce.Core\HuorongAce.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HuorongAce.Native.Tests" />
  </ItemGroup>

</Project>
