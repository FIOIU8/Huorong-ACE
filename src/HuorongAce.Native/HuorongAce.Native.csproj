<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only by design: everything here is Win32 / GDI+.

         The platform version is pinned to 10.0.19041 rather than the plain
         `net8.0-windows` because the notification code calls the WinRT toast
         API (Windows.UI.Notifications) directly. That API only shows up in the
         projection when the SDK version is declared explicitly.

         Declaring the platform also silences the CA1416
         platform-compatibility analysis. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>HuorongAce.Native</RootNamespace>
    <AssemblyName>HuorongAce.Native</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HuorongAce.Core\HuorongAce.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HuorongAce.Native.Tests" />
  </ItemGroup>

</Project>
