* text=auto eol=lf

# Windows scripts are kept in the native line ending format.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and generated packages.
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
